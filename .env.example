# Copy this file and fill in only what you need. Every variable is optional:
# `npm run dev` works without any env file (demo mode, defaults below).

# OpenAI API key for live AI agents. Server-only, never sent to the browser or logged.
# Empty -> agents run in deterministic demo mode.
OPENAI_API_KEY=

# OpenAI model id used by the agents (Chat Completions with strict tools). Default: gpt-4.1-mini
OPENAI_MODEL=

# SQLite database location. Default: file:./data/devlog.db
DATABASE_URL=

# Server log level: fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL=

# Max model calls per agent run (1-8). Default: 8. Lower it to cap cost.
AGENT_MAX_STEPS=

# Max output tokens per model call (64-2048). Default: 2048.
# Too small a value truncates agent results (they fall back to the deterministic rule).
OPENAI_MAX_OUTPUT_TOKENS=

# Set to 1 to enable the dev-only paid smoke endpoint POST /api/dev/agent-smoke
# (localhost only, never in production, max 4 calls x 400 tokens). Run it with `npm run smoke:ai`.
# Requests also need a local secret from data/ (created automatically; delete the file to rotate it).
# Extra safety: run the dev server on loopback only: `npx next dev -H 127.0.0.1`.
# Leave empty otherwise: every smoke request costs real API tokens.
AI_SMOKE=

# Force AI mode: live | demo. Empty -> detected automatically
# (live when OPENAI_API_KEY is set, otherwise demo). live without a key fails on startup.
AI_MODE=
